# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000

# ===== 区域配置 =====
# 默认区域（同时用于 Auth 和 API，除非单独配置）
REGION=us-east-1
# Token 刷新区域（可选，未配置时回退到 REGION）
# AUTH_REGION=us-east-1
# API 请求区域（可选，未配置时回退到 REGION）
# API_REGION=us-east-1

# ===== Kiro 版本伪装 =====
KIRO_VERSION=0.9.2
SYSTEM_VERSION=darwin#24.6.0
NODE_VERSION=22.21.1

# ===== 数据库 =====
DATABASE_URL=sqlite+aiosqlite:///data/kiro2api.db

# ===== 安全 =====
# Admin API 密钥（留空则禁用 Admin API 认证）
ADMIN_API_KEY=
# 是否要求外部 API Key 认证（true/false）
REQUIRE_API_KEY=false

# ===== 负载均衡 =====
# 模式：priority（优先级）或 balanced（均衡）
LOAD_BALANCING_MODE=priority

# ===== 代理配置（全局） =====
# 支持 http/https/socks5 协议
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ===== 外部 count_tokens API（可选）=====
# COUNT_TOKENS_API_URL=
# COUNT_TOKENS_API_KEY=
# COUNT_TOKENS_AUTH_TYPE=x-api-key

# ===== 调试日志中间件 =====
# 日志输出目录
DEBUG_LOG_DIR=data/debug-log
# 中间件 0: 记录 OpenAI → Anthropic 转换（true/false）
DEBUG_LOG_MIDDLEWARE_0=false
# 中间件 1: 记录 Anthropic → Kiro 转换（true/false）
DEBUG_LOG_MIDDLEWARE_1=false
# 中间件 2: 记录 Kiro 返回 → Anthropic 转换（true/false）
DEBUG_LOG_MIDDLEWARE_2=false